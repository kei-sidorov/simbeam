# Copy to /etc/simbeam/signal.env on the server and fill in real values (chmod 600).
# SIMCAST_APP_SECRET is read from the environment by the broker; it must match the
# bench/app value used to sign subscription POSTs.
SIMCAST_APP_SECRET=change-me-to-a-long-random-string

# API token of the Cloudflare Realtime TURN key named by --turn-key-id. Both come
# from the Cloudflare dashboard (Realtime → TURN Keys); the token is shown once.
SIMBEAM_TURN_API_TOKEN=change-me-cloudflare-turn-key-token

# Broker CLI flags (word-split by systemd). Bind to localhost; Caddy terminates TLS.
SIMCAST_SIGNAL_ARGS=--addr 127.0.0.1:9000 --db /var/lib/simbeam/simbeam.db --stun stun:stun.cloudflare.com:3478 --turn-key-id YOUR_CLOUDFLARE_TURN_KEY_ID --turn-ttl 24h
